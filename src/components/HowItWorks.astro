---
import { fetchDictionary, type Locale, type Dictionary } from '../i18n/i18n';
const { lang } = Astro.props as { lang: Locale };

const dict = await fetchDictionary(lang);

type HowItWorksKey = keyof typeof dict;

const t = (key: HowItWorksKey) => dict[key] ?? key;

---
<footer
  class="mt-12 bg-white/60 backdrop-blur-sm rounded-3xl p-8 border border-gray-200/50"
>
  <div class="text-center">
    <h4 class="text-lg font-bold text-gray-900 mb-3">{t('howItWorks.title')}</h4>
    <div class="grid sm:grid-cols-3 gap-4 sm:gap-6 text-sm text-gray-600">
      <div class="flex flex-col items-center gap-2">
        <div
          class="w-12 h-12 bg-brand-100 rounded-xl flex items-center justify-center"
        >
          <span class="text-2xl">📦</span>
        </div>
        <p><strong>{t('howItWorks.limit')}:</strong> {t('howItWorks.limitExplanation')}</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <div
          class="w-12 h-12 bg-brand-100 rounded-xl flex items-center justify-center"
        >
          <span class="text-2xl">💰</span>
        </div>
        <p><strong>{t('howItWorks.overlimit')}:</strong> {t('howItWorks.overlimitExplanation')}</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <div
          class="w-12 h-12 bg-brand-100 rounded-xl flex items-center justify-center"
        >
          <span class="text-2xl">📋</span>
        </div>
        <p><strong>{t('howItWorks.draft_law')}:</strong> {t('howItWorks.draft_law_explanation')}</p>
      </div>
    </div>
  </div>
</footer>
