---
import { fetchDictionary, type Locale} from '../i18n/i18n';

const lang = Astro.props.lang;;

const dict = await fetchDictionary(lang as Locale);

type HowItWorksKey = keyof typeof dict;

const t = (key: HowItWorksKey) => dict[key] ?? key;

const isActive = (l: Locale) => l === lang;

---
<header
  class="bg-white/80 backdrop-blur-sm border-b border-brand-100 sticky top-0 z-10"
>
  <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div
        class="w-10 h-10 bg-gradient-to-br from-brand-400 to-sky-600 rounded-xl flex items-center justify-center"
      >
        <svg
          class="w-6 h-6 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width={2}
            d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
          ></path>
        </svg>
      </div>
      <div>
        <span class="text-xl font-bold text-gray-900">MytoCalc</span>
        <p class="text-sm text-gray-600">{t('title')}</p>
      </div>
    </div>
    <nav aria-label="Language selector" class="flex items-center gap-4 mt-2 text-sm text-gray-700">
      <a href="/" 
        aria-current={isActive('uk') ? 'page' : undefined}
        class="hover:text-brand-500 transition-colors duration-200 hover:font-bold"
        class:list={[{'pointer-events-none font-bold text-brand-500': isActive('uk')}]}
        lang="uk" hreflang="uk"
        >UA</a> |
      <a href="/en"
        aria-current={isActive('en') ? 'page' : undefined}
        class="hover:text-brand-500 transition-colors duration-200 hover:font-bold"
        class:list={[{'pointer-events-none font-bold text-brand-500': isActive('en')}]}
        lang="en" hreflang="en"
        >EN</a>
    </nav>

  </div>
</header>
