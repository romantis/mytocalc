---
import DirectEmail from "../components/DirectEmail.tsx";
import { fetchDictionary, type Locale } from "../i18n/i18n";
const thisYear = new Date().getFullYear();

const lang = Astro.props.lang;

const dict = await fetchDictionary(lang as Locale);

type HowItWorksKey = keyof typeof dict;

const t = (key: HowItWorksKey) => dict[key] ?? key;
---

<footer class="bg-gray-800 text-white py-8 sm:py-12">
  <div class="container mx-auto px-6">
    <div class="text-center text-gray-400">
      <div>
        &copy; {thisYear} MytoCalc — {t("footer.a project by")}
        <span class="max-[415px]:block">
          <a href="https://github.com/romantis" class="hover:text-gray-300">
            Roman Tyshchenko
          </a>
        </span>
      </div>
      <div>
        🪲
        <a
          href="https://github.com/romantis/mytocalc-feedback/issues/new?template=bug_report.md"
          target="_blank"
          rel="noopener"
          class="hover:text-gray-300"
        >
          {t("footer.Report a bug")}
        </a>
        <span class="max-[415px]:hidden">
          &nbsp;|&nbsp;
        </span>
        <span class="max-[415px]:block">
          ✉️
         <DirectEmail client:load>
           {t("footer.Other questions")}
         </DirectEmail>
        </span>
      </div>
    </div>
  </div>
</footer>
