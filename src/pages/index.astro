---
import DutyCalculator from '../components/DutyCalculator';
import Layout from '../layouts/Layout.astro';
import { getRates } from '../lib/rates';

const rates = await getRates();
---

<Layout>
	<DutyCalculator 
		rates={rates}
		initialAmount={150}
		initialCurrency="EUR"
		initialDraftLaw={false}
		client:load />
</Layout>
