---
import "../styles/global.css";
import Header from '../components/Header.astro';
import type { Locale } from "../i18n/i18n";
import Footer from "../components/Footer.astro";

const lang = (Astro.props.lang || 'uk') as Locale;

const pageTitle =
  Astro.props.title || "MytoCalc – Калькулятор мита та ПДВ для імпорту";
// const pageDescription =
//   Astro.props.description ||
//   `Розрахуйте мито та ПДВ на імпорт до України за секунди. Актуальні ставки, автоматичний курс валют і зручний UA / EN інтерфейс.`;
// const socialMediaDescription =
//   Astro.props.socialMediaDescription ||
//   "Онлайн-калькулятор MytoCalc миттєво рахує мито й ПДВ для імпорту в Україну. Зрозумій, скільки заплатиш, перш ніж замовляти товар. Спробуй!";

const descriptions = {
  uk: {
    seo: "Розрахуйте мито та ПДВ на імпорт до України за секунди. Актуальні ставки, автоматичний курс валют і зручний UA/EN інтерфейс.",
    social: "Онлайн-калькулятор MytoCalc миттєво рахує мито й ПДВ для імпорту в Україну. Зрозумій, скільки заплатиш, перш ніж замовляти товар. Спробуй за секунду!"
  },
  en: {
    seo: "Calculate customs duty and VAT for imports to Ukraine in seconds. Live rates, automatic currency conversion, and a simple UA/EN interface.",
    social: "MytoCalc instantly estimates customs duty & VAT when shipping goods to Ukraine. Know the total cost before you buy — try the calculator now!"
  }
};
const { seo, social } = descriptions[lang];
  
const pageKeywords =
  Astro.props.keywords ||
  `mytocalc, калькулятор мита, калькулятор митних платежів, ПДВ калькулятор, розрахунок мита, імпорт в Україну, мито та ПДВ, онлайн калькулятор мита`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Calculator",
  "name": "MytoCalc",
  "url": Astro.site,
  "description": social,
  "inLanguage": lang === "uk" ? "uk-UA" : "en-US",
  "applicationCategory": "FinanceApplication",
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "image": "https://mytocalc.com/og-cover.png"
};

---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="icons/favicon.svg" />
    <link rel="icon" type="image/png" href="icons/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={seo} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="Metric Harmony" />
    <link rel="canonical" href="https://mytocalc.com/" />

    <!-- === Мульти-мовність === -->
    <link rel="alternate" hreflang="uk" href="https://mytocalc.com/" />
    <link rel="alternate" hreflang="en" href="https://mytocalc.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://mytocalc.com/" />

    <!-- === Open Graph === -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={social}
    />
    <meta property="og:url" content="https://mytocalc.com/" />
    <meta property="og:image" content="https://mytocalc.com/og-cover.png" />
    <meta
      property="og:image:alt"
      content="Скріншот онлайн-калькулятора MytoCalc"
    />

    <!-- === Twitter Card === -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MytoCalc" />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content={social}
    />
    <meta name="twitter:image" content="https://mytocalc.com/og-cover.png" />

    <!-- === Schema.org (JSON-LD) === -->
  <script 
    type="application/ld+json" 
    set:html={JSON.stringify(jsonLd).replaceAll('</', '<\\/')}
    ></script>

  </head>
  <body>
    <div class="min-h-screen bg-gradient-to-br from-brand-50 via-white to-sky-50">

      <Header lang={lang}/>
      
      <slot />
      
      <Footer lang={lang}/>
    </div>
  </body>
</html>
